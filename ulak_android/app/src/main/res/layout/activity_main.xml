<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Neon Title Section -->
    <LinearLayout
        android:id="@+id/titleLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/logo"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/app_name" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ULAK"
            android:textSize="40sp"
            android:textStyle="bold"
            android:textColor="@color/neon_blue"
            android:shadowColor="@color/neon_blue"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="20" />
    </LinearLayout>

    <!-- Announcement Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/announcementCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/titleLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_neon"
            android:padding="16dp"
            android:animateLayoutChanges="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📢 Duyuru: "
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/neon_blue" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/announcementText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Yükleniyor..."
                        android:textSize="14sp"
                        android:textColor="@color/neon_cyan"
                        android:maxLines="10"
                        android:ellipsize="end" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/closeAnnouncementButton"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="✕"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:background="@android:color/transparent"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/announcementProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:indeterminateTint="@color/neon_cyan" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Neon Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/infoCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/transparent"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/announcementCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_neon"
            android:padding="20dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/encryptionStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 AES-256 Şifrelenmiş Biçimde Gönderiyorsunuz"
                android:textSize="14sp"
                android:textColor="@color/neon_green"
                android:textStyle="bold"
                android:visibility="gone"
                android:shadowColor="@color/neon_green"
                android:shadowRadius="10"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/deviceNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cihazınız: Android"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:clickable="true"
                android:focusable="true" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/ipAddressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: 192.168.1.1"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/deviceCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 cihaz bulundu"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/neon_cyan"
                android:shadowColor="@color/neon_cyan"
                android:shadowRadius="8"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Link Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/linkSendButton"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="🔗 Link Üzerinden Gönder"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:background="@drawable/bg_button_gradient"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/infoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Devices List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/devicesRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/linkSendButton"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Neon Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#0f1729"
        app:itemIconTint="@color/bottom_nav_color"
        app:itemTextColor="@color/bottom_nav_color"
        app:itemRippleColor="@color/neon_cyan"
        app:itemActiveIndicatorStyle="@style/BottomNavIndicator"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
